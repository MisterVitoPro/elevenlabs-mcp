# ElevenLabs API key (required) -- get from https://elevenlabs.io/app/settings/api-keys
#
# This must be the SECRET KEY, which starts with "sk_" and is shown only once,
# when the key is created or rotated. It is NOT the key ID shown in the dashboard
# list. Using the ID here fails with "API key ID used as API key".
ELEVENLABS_API_KEY=

# Key ID for the key above (optional, informational only)
#
# The dashboard lists keys by ID, not by name, so record the ID here to keep track
# of which key this config uses. Never used for authentication; surfaced in the
# get_usage tool output as "api_key_id".
# ELEVENLABS_API_KEY_ID=

# Output directory for generated audio (default: ~/elevenlabs-output)
# ELEVENLABS_OUTPUT_DIR=

# Input directory for audio source files (default: ~/elevenlabs-input)
# ELEVENLABS_INPUT_DIR=

# HTTP timeout in seconds (default: 120)
# ELEVENLABS_TIMEOUT=

# Max characters for text_to_speech input (default: 5000)
# MAX_TTS_CHARS=

# Comma-separated allowlist of model IDs (default: no restriction)
# ELEVENLABS_MODEL_ALLOWLIST=
